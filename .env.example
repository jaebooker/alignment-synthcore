# Copy to .env and fill in. .env is gitignored and never leaves your machine.
# Only needed for Testbed 6 (control protocols).

# Required. Create one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Needed only if the key is not scoped to one workspace (the API error says so).
# Workspace IDs start with wrkspc_ (not the org ID). Find them at
# https://platform.claude.com/settings/workspaces
ANTHROPIC_WORKSPACE_ID=

# Optional overrides. Untrusted = the strong model that solves tasks and,
# in attack mode, tries to slip in backdoors. Trusted = the weaker monitor.
UNTRUSTED_MODEL=claude-sonnet-5-5
TRUSTED_MODEL=claude-haiku-5-5

# Optional hard cap on API spend per run, in US dollars.
MAX_SPEND_USD=20
